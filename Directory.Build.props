<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(GroundKitProviderReleaseTag)' != ''">
    <AssemblyMetadata Include="GroundKitProviderReleaseTag" Value="$(GroundKitProviderReleaseTag)" />
    <AssemblyMetadata Include="GroundKitProviderVersion" Value="$(GroundKitProviderVersion)" />
  </ItemGroup>
</Project>